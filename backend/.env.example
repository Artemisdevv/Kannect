# Copy to .env (never commit .env)
# Local (docker compose). For Supabase see docs/supabase.md (use the SESSION pooler string, port 5432)
DATABASE_URL=postgresql+psycopg://kadanet:kadanet@localhost:5432/kadanet
# local | development | production. Anything except local/development refuses the default JWT secret
APP_ENV=local
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=10080
# Comma-separated origins allowed by CORS (local dev, deployed PWA). Lovable previews are allowed by regex.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Demo OTP, always accepted until real SMS is wired
DEMO_OTP=123456
# Public base URL used to build e-bill share links
PUBLIC_BASE_URL=http://localhost:8000
# AI endpoints (/shop/ai/*)
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# Phone verification: demo (fixed OTP, default) or phone_email (real SMS, see docs/phone-verification.md)
OTP_PROVIDER=demo
PHONE_EMAIL_CLIENT_ID=
# Numbers that may still use DEMO_OTP when OTP_PROVIDER=phone_email (default: the 11 seeded demo accounts).
# Set it empty before a real pilot to switch demo logins off. Comma separated, E.164.
# DEMO_PHONES=
